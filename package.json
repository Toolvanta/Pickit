{
  "name": "pickkit",
  "description": "Colour picker and font inspector for Chrome",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "preview": "wxt build && node scripts/preview.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  }
}
